<?xml version="1.0" encoding="utf-8"?>
<!-- Splash shown until Flutter draws its first frame on Android 11 and
     below. Android 12+ ignores this and uses the splash-screen API instead
     (see values-v31/styles.xml). Navy in both light and dark: the mark is
     drawn for a dark ground, so following the system theme would strand it
     on white. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ironyx_navy" />
    <item
        android:width="120dp"
        android:height="120dp"
        android:drawable="@drawable/ic_launcher_foreground"
        android:gravity="center" />
</layer-list>
