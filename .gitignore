# Dart / Flutter
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
pubspec_overrides.yaml

# Android (packages/flutter_tools/templates/app/android.tmpl/.gitignore)
android/gradle-wrapper.jar
android/.gradle/
android/captures/
android/gradlew
android/gradlew.bat
android/local.properties
android/**/GeneratedPluginRegistrant.java
android/**/.cxx/
# Never publicly share your keystore.
android/key.properties
android/**/*.keystore
android/**/*.jks

# iOS (packages/flutter_tools/templates/app/ios.tmpl/.gitignore)
ios/**/dgph
ios/**/*.mode1v3
ios/**/*.mode2v3
ios/**/*.moved-aside
ios/**/*.pbxuser
ios/**/*.perspectivev3
ios/**/*sync/
ios/**/.sconsign.dblite
ios/**/.tags*
ios/**/.vagrant/
ios/**/DerivedData/
ios/**/Icon?
ios/**/Pods/
ios/**/.symlinks/
ios/**/xcuserdata/
ios/**/.generated/
ios/Flutter/App.framework
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/ephemeral/
ios/Flutter/app.flx
ios/Flutter/app.zip
ios/Flutter/flutter_assets/
ios/Flutter/flutter_export_environment.sh
ios/ServiceDefinitions.json
ios/Runner/GeneratedPluginRegistrant.*

# Linux (packages/flutter_tools/templates/app/linux.tmpl/.gitignore)
linux/flutter/ephemeral

# Web
web/**/flutter_service_worker.js

# Generated code — regenerated by build_runner in CI
*.g.dart
*.freezed.dart

# Generated by `flutter gen-l10n` (runs as part of `flutter pub get`) from the
# committed .arb files next to them. Since Flutter 3.19 these land in lib/
# rather than a synthetic package, but they are still build output.
lib/l10n/app_localizations*.dart
lib/l10n/untranslated.json

# IDE
# Run configurations are committed: they carry the --dart-define-from-file
# wiring (ADR-8) and no secrets. Everything else in .idea/ is personal.
.idea/*
!.idea/runConfigurations/
# .vscode/launch.json is committed for the same reason. Everything else in
# .vscode/ is personal.
.vscode/*
!.vscode/launch.json
*.iml

# Test output
coverage/
**/failures/

# OS
.DS_Store

# Local IDE/agent settings
.claude/

# Supabase credentials for --dart-define-from-file (ADR-8).
# The anon key is public by design, but the project URL still stays out of git.
supabase.json

# Upstream exercise dump + original images, re-downloaded on demand by
# scripts/build_exercise_seed.py. Large, and reproducible from the network.
scripts/.cache/
